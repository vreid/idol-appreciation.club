{
	http_port 8080
	https_port 8443

	# Certificates + ACME state in object storage: both edge replicas
	# see the same cert objects, and CertMagic's S3 lock makes exactly
	# one replica renew at a time (docs/scaling-architecture.md, "Caddy,
	# horizontally"). Credentials ride the AWS_ standard chain from the
	# app-env secret; endpoint/bucket are helm-injected by deploy.yml.
	storage s3 {
		endpoint "{{ .Values.edgeStorage.endpoint }}"
		bucket "{{ .Values.edgeStorage.bucket }}"
		prefix "{{ .Values.edgeStorage.prefix }}"
	}

	# In-memory tile cache (Souin/cache-handler, otter storage). RFC
	# 7234 strict + no-store default means ONLY responses carrying
	# explicit cache headers are stored: versioned tile responses say
	# `Cache-Control: public, max-age=31536000, immutable`; everything
	# unmarked (SSE, API JSON, SPA index) passes through untouched.
	cache {
		default_cache_control no-store
		ttl 31536000s
		cache_name idol-edge
		otter {
			configuration {
				# Items, not bytes: ~4000 tiles x ~60 KB worst case
				# stays well under the 512Mi memory limit.
				size 4000
			}
		}
	}
}

(app) {

	encode zstd gzip
	root * /usr/share/caddy

	# route preserves written order; handle groups are exclusive, so
	# only /api/tiles ever passes through the cache handler (SSE and
	# the rest of /api must not touch it: streaming, uncacheable).
	route {
		handle /api/tiles/* {
			cache
			reverse_proxy backend.idol.svc.cluster.local:80
		}

		handle /api/* {
			reverse_proxy backend.idol.svc.cluster.local:80 {
				flush_interval -1
			}
		}

		handle {
			@immutable path /assets/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"

			@index path / /index.html
			header @index Cache-Control "no-cache"

			try_files {path} /index.html
			file_server
		}
	}
}
# www serves the app DIRECTLY (2026-10-15, user-ordered service
# recovery): the www->apex redirect sent every user into the apex's
# LE 429 window (duplicate-cert quota burned by the outage's repeated
# rollbacks; caddy auto-retries per the order's Retry-After). The
# canonicalization redirect returns with the edge cleanup later.

# The apex identifier's cert lives in the shared S3 storage (obtained
# 15:35Z after the LE retry); it imports the same app snippet.
idol-appreciation.club {
	import app
}

www.idol-appreciation.club {
	import app
}
