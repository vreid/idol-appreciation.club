{
	http_port 8080
	https_port 8443
}

idol-appreciation.club {
	encode zstd gzip
	root * /usr/share/caddy

	# SSE: keep /api/events unbuffered end-to-end.
	reverse_proxy /api/* backend.idol.svc.cluster.local:8080 {
		flush_interval -1
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

# www -> apex
www.idol-appreciation.club {
	redir https://idol-appreciation.club{uri} permanent
}
