{
  "name": "idol-appreciation-club-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:contract": "vp test contract",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config e2e/playwright.config.ts --grep @smoke"
  },
  "dependencies": {
    "chota": "^0.9.0",
    "leaflet": "^1.9.4",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^21.0.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.9",
    "vite-plus": "catalog:",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
